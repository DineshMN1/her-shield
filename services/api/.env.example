# Database (PostgreSQL) - Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Redis (Upstash, Railway, Redis Cloud, etc.)
REDIS_URL="redis://default:password@host:6379"

# Frontend URL for CORS (comma-separated for multiple domains)
FRONTEND_URL="https://your-app.vercel.app,https://your-custom-domain.com"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Optional: External Services
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

GOOGLE_AI_API_KEY=""
