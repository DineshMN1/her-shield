generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  FAMILY
}

enum SOSStatus {
  PENDING
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  VIDEO
  CLINIC
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  phone               String   @unique
  password            String
  role                UserRole @default(PATIENT)
  firstName           String
  lastName            String
  avatar              String?
  isVerified          Boolean  @default(false)
  isActive            Boolean  @default(true)
  oneSignalPlayerId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  sosAlerts           SOSAlert[]           @relation("PatientSOS")
  emergencyContacts   EmergencyContact[]   @relation("PatientEmergencyContact")
  appointments        Appointment[]        @relation("PatientAppointments")
  doctorAppointments  Appointment[]        @relation("DoctorAppointments")
  messages            Message[]
  aiChats             AIChat[]
  notifications       Notification[]

  @@index([email])
  @@index([phone])
}

model PatientProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  dateOfBirth        DateTime
  bloodGroup         String?
  dueDate            DateTime?
  pregnancyWeek      Int?
  medicalHistory     Json?
  allergies          String[]
  currentMedications String[]
  
  address            String?
  city               String?
  state              String?
  zipCode            String?
  latitude           Float?
  longitude          Float?
  
  primaryDoctorId    String?
  primaryDoctor      DoctorProfile? @relation("PrimaryDoctor", fields: [primaryDoctorId], references: [id])
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  healthMetrics      HealthMetric[]
  
  @@index([userId])
}

model DoctorProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  specialization      String
  licenseNumber       String    @unique
  yearsOfExperience   Int
  rating              Float     @default(0)
  totalReviews        Int       @default(0)
  
  bio                 String?
  hospitalAffiliation String?
  consultationFee     Float?
  
  isAvailable         Boolean   @default(true)
  availableHours      Json?
  
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  primaryPatients     PatientProfile[] @relation("PrimaryDoctor")
  sosResponses        SOSAlert[]
  
  @@index([userId])
}

model EmergencyContact {
  id           String   @id @default(cuid())
  patientId    String
  patient      User     @relation("PatientEmergencyContact", fields: [patientId], references: [id], onDelete: Cascade)
  
  name         String
  phone        String
  relationship String
  email        String?
  priority     Int      @default(1)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@index([patientId])
}

model SOSAlert {
  id                 String        @id @default(cuid())
  patientId          String
  patient            User          @relation("PatientSOS", fields: [patientId], references: [id], onDelete: Cascade)
  
  status             SOSStatus     @default(PENDING)
  urgencyLevel       Int           @default(5)
  
  latitude           Float
  longitude          Float
  address            String?
  
  symptoms           String[]
  description        String?
  aiAnalysis         Json?
  
  respondingDoctorId String?
  respondingDoctor   DoctorProfile? @relation(fields: [respondingDoctorId], references: [id])
  
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)

  doctorId    String
  doctor      User              @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  duration    Int               @default(30)
  status      AppointmentStatus @default(SCHEDULED)
  type        AppointmentType   @default(CLINIC)
  reason      String?

  roomId      String?
  notes       String?
  aiSummary   String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  prescription  Prescription?
  report        ConsultationReport?
  scans         MedicalScan[]

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
}

model Prescription {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  diagnosis     String
  medicines     Json        // Array of {name, dosage, frequency, duration, instructions}
  advice        String?
  followUpDate  DateTime?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appointmentId])
}

model ConsultationReport {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  chiefComplaint    String
  examination       String?
  diagnosis         String
  treatmentPlan     String?
  vitals            Json?     // {bp, pulse, temp, weight, etc}
  recommendations   String[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appointmentId])
}

model MedicalScan {
  id            String       @id @default(cuid())
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  patientId     String
  title         String
  scanType      String       // ULTRASOUND, BLOOD_TEST, XRAY, MRI, etc
  fileUrl       String
  fileType      String       // image/pdf
  notes         String?
  scanDate      DateTime     @default(now())

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([patientId])
  @@index([appointmentId])
}

model HealthMetric {
  id               String   @id @default(cuid())
  patientProfileId String
  patientProfile   PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  
  type             String
  value            Float
  unit             String
  notes            String?
  
  recordedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  
  @@index([patientProfileId])
  @@index([type])
  @@index([recordedAt])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  
  createdAt  DateTime @default(now())
  
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model AIChat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  messages  Json
  context   Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  title     String
  body      String
  data      Json?

  isRead    Boolean  @default(false)
  sentAt    DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// Hospital/Clinic Organizations
model Organization {
  id                String   @id @default(cuid())
  name              String   // Apollo, Kavery, Global, Chettinad
  type              String   @default("HOSPITAL") // HOSPITAL, CLINIC, DIAGNOSTIC

  address           String?
  city              String?
  state             String?
  phone             String
  email             String?
  website           String?

  emergencyPhone    String?  // 24/7 emergency number
  emergencyWhatsApp String?  // WhatsApp for emergency

  isActive          Boolean  @default(true)
  isVerified        Boolean  @default(false)

  // Subscription/Plan
  plan              String   @default("FREE") // FREE, BASIC, PREMIUM
  planExpiresAt     DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  doctors           OrganizationDoctor[]
  emergencyCalls    EmergencyCall[]

  @@index([name])
  @@index([city])
  @@index([isActive])
}

// Link doctors to organizations (many-to-many)
model OrganizationDoctor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  doctorName     String
  doctorPhone    String
  doctorEmail    String?
  specialization String?
  isOnCall       Boolean      @default(false) // Available for emergency calls

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([isOnCall])
}

// Emergency call tracking (for escalation)
model EmergencyCall {
  id             String        @id @default(cuid())

  patientName    String
  patientPhone   String
  roomLink       String        // Jitsi room link

  status         String        @default("WAITING") // WAITING, CONNECTED, ESCALATED, COMPLETED

  // Primary doctor
  primaryDoctorPhone String?
  primaryDoctorJoinedAt DateTime?

  // Escalation tracking
  escalatedAt    DateTime?
  escalatedToOrgs String[]     // Organization IDs that received escalation

  // Which org doctor responded
  respondedOrgId String?
  respondedOrg   Organization? @relation(fields: [respondedOrgId], references: [id])
  respondedDoctorName String?
  respondedAt    DateTime?

  completedAt    DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// WebRTC signaling via DB (no external signaling server needed)
model VideoSignal {
  id          String   @id @default(cuid())
  roomId      String
  senderId    String
  recipientId String
  type        String   // 'offer' | 'answer' | 'candidate'
  payload     String   // JSON-encoded SDP or RTCIceCandidate
  consumed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([roomId, recipientId, consumed])
  @@index([createdAt])
}
